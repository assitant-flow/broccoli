{
  "name": "broccoli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:up": "docker compose up -d postgres",
    "seed": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/seed.ts",
    "smoke": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/smoke.ts",
    "verify:suspend": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/verify-suspend.ts",
    "verify:github": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/verify-github.ts",
    "verify:sandbox": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/verify-sandbox.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "verify:retrieval": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/verify-retrieval.ts",
    "verify:services": "DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli tsx scripts/verify-services.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "next": "^15.3.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}