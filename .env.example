# 复制为 .env 并按需修改（本地开发默认值即可跑通 Mock 引擎演示）

DATABASE_URL=postgres://broccoli:broccoli@localhost:5432/broccoli
# 会话签名密钥（生产必换）
SESSION_SECRET=change-me
# 凭证加密主密钥（AES-256-GCM KEK，生产接 KMS）
BROCCOLI_MASTER_KEY=change-me-32bytes
# 单用户沙箱并发上限（AC-D1）
BROCCOLI_MAX_CONCURRENCY=2
# 等待确认快照保留时长（小时，FR-D5）
BROCCOLI_SNAPSHOT_TTL_HOURS=24
# 数据目录（本地 git 仓库 / 邮件 outbox / 产物 / 快照）
BROCCOLI_DATA_DIR=.data
# 执行引擎：mock（离线演示）| claude（真实 Anthropic API，需用户 BYO key）
BROCCOLI_ENGINE=mock
# 验收回路最大自动修复轮数（FR-D14）
BROCCOLI_MAX_REPAIR_ROUNDS=1
# 站点地址（邮件深链）
BROCCOLI_SITE_URL=http://localhost:3000

# 执行沙箱：local（宿主进程，开发/CI 默认）| docker（容器隔离 + 白名单 egress proxy，需 Docker）
BROCCOLI_SANDBOX=local
