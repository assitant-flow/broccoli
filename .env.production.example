# ===== Broccoli 公网部署环境模板 =====
# 用法：cp .env.production.example .env.production ，逐项填写后再部署。
# .env.production 含密钥，已加入 .gitignore，切勿提交。
#
# 生成随机密钥：
#   openssl rand -hex 32    （SESSION_SECRET / BROCCOLI_MASTER_KEY）
#   openssl rand -hex 24    （POSTGRES_PASSWORD）

# 公网模式：启动守卫会对下列配置做严格校验（弱口令、http、演示账号等一律拒绝启动）
BROCCOLI_MODE=public

# 你的域名（DNS A 记录指向服务器公网 IP）
BROCCOLI_DOMAIN=broccoli.example.com
BROCCOLI_SITE_URL=https://broccoli.example.com

# 会话签名密钥（≥32 位随机）
SESSION_SECRET=

# 主密钥：加密存储的 AI / GitHub Token。一旦设定不可更换，否则已存 Token 无法解密
BROCCOLI_MASTER_KEY=

# 数据库口令（与 docker-compose.prod.yml 内的 DATABASE_URL 共用）
POSTGRES_PASSWORD=

# 注册策略：closed（默认，管理员用 pnpm user:create 开通账号）| open（开放自助注册）
BROCCOLI_REGISTRATION=closed

# 执行沙箱：local 会在应用容器内执行仓库测试代码，仅适用于可信用户。
# 确认理解风险后把 BROCCOLI_ACK_LOCAL_SANDBOX 改为 1，否则拒绝启动。
BROCCOLI_SANDBOX=local
BROCCOLI_ACK_LOCAL_SANDBOX=0

# LLM 引擎：claude（用户在「接入设置」填写自己的 Token；公网不共用平台 Token）
BROCCOLI_ENGINE=claude

# GitHub OAuth（可选）：回调地址 = BROCCOLI_SITE_URL/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 仅本地预演（http 站点，不申请证书）时使用：BROCCOLI_DOMAIN=http://:80 并设 BROCCOLI_INSECURE_HTTP=1
# 公网部署请保持为空或删除此行
BROCCOLI_INSECURE_HTTP=
